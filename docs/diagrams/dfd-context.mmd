%% APX AUTOMAI - Level 0 Data Flow Diagram (Context)
%% -
%% Supersedes the earlier version of this file, which named Semaphore as the
%% only SMS provider and did not say which port mail leaves on. Both matter:
%% SMS_DRIVER also accepts unisms and defaults to log, and Render drops
%% outbound 25, 465 and 587, so 2525 is not a detail.
%% -
%% Legend: stadium = process, rectangle = external entity, cylinder = datastore.
%% Level 0 carries no datastore by convention: the whole system is one process.
%% -
%% Audit trail for every edge on this diagram:
%%   Guest intake      routes/web.php POST /booking/guest -> GuestBookingController
%%   Customer intake   POST /customer/bookings -> Customer\DashboardController::store
%%   Admin             routes/web.php prefix admin, middleware auth + role:admin
%%   Cron              GET /cron/{task?} -> CronController, throttle:cron
%%   Mail              config/mail.php smtp, MAIL_PORT default 2525
%%   SMS               AppServiceProvider::register binds SmsGateway by SMS_DRIVER

flowchart LR
    GUEST["Guest Visitor"]
    CUST["Registered Customer"]
    ADMIN["Administrator"]
    CRON["External Cron Service"]
    MAIL["Brevo SMTP Relay on port 2525"]
    SMSGW["SMS Gateway Semaphore or UniSMS"]

    SYS(["0 APX AUTOMAI Service Booking System"])

    GUEST -->|"vehicle details plus contact details plus chosen service or bundle plus date and time"| SYS
    SYS -->|"reference number plus booking received email plus password set link"| GUEST

    CUST -->|"login credentials plus vehicle records plus booking choice plus points to redeem plus cancel or reschedule reply"| SYS
    SYS -->|"dashboard plus booking history plus points balance plus service due list plus reminder messages"| CUST

    ADMIN -->|"login credentials plus status changes plus cancellation reason plus catalog and settings edits plus report filters"| SYS
    SYS -->|"schedule plus customer records plus delivery log plus audit trail plus report figures and CSV exports"| ADMIN

    CRON -->|"token guarded GET on slash cron slash schedule every five minutes"| SYS
    SYS -->|"HTTP 200 plus task name plus elapsed milliseconds plus command output"| CRON

    SYS -->|"SMTP envelope plus HTML reminder or confirmation body"| MAIL
    MAIL -->|"accepted or SMTP error raised as an exception"| SYS

    SYS -->|"recipient in E164 plus GSM7 folded message body"| SMSGW
    SMSGW -->|"provider reference id plus status or failure reason"| SYS
