# APP_NAME heads every email Laravel composes, and APP_URL is where the links
# inside them point — the button on a booking email, and the password-setup
# link a guest is sent after booking. Left at the framework defaults these
# read "Laravel" and point at http://localhost, which is the developer's own
# machine, so the links are dead for whoever receives them.
#
# :8000 matches `php artisan serve`. On Render the entrypoint takes the real
# address from RENDER_EXTERNAL_URL — see docker-entrypoint.sh.
APP_NAME="APX AutoMai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. MAIL_MAILER=log writes messages to storage/logs instead of sending
# them, which is the right default for a fresh checkout. Set it to smtp to
# deliver for real.
#
# Note this app reads MAIL_SCHEME, not MAIL_ENCRYPTION (Laravel 11+). Leave
# MAIL_SCHEME=null wherever STARTTLS is negotiated on the wire (ports 587 and
# 2525); set it to smtps only for an implicit-TLS port such as 465 or 2465.
#
# PICK A PORT THE HOST ALLOWS. Render's free instances drop outbound traffic
# to ports 25, 465 and 587 at the firewall, which surfaces as a connection
# timeout rather than a rejected login — easy to misread as bad credentials.
# Port 2525 is not blocked, so this project uses Brevo:
#
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=2525
#   MAIL_USERNAME   the Brevo login email
#   MAIL_PASSWORD   an SMTP key from Brevo (SMTP & API -> SMTP keys),
#                   never the account password
#   MAIL_FROM_ADDRESS must be verified under Senders, Domains & Dedicated IPs
#
# Gmail (smtp.gmail.com:587, MAIL_PASSWORD = a 16-character App Password with
# the spaces removed) works fine locally and on any host that permits 587.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin bootstrap. Read by `php artisan apx:ensure-admin`, which the Docker
# entrypoint runs on every boot so a fresh deploy has an account to sign in
# with. Leave blank to skip provisioning entirely, and remove ADMIN_PASSWORD
# from the environment once a real admin account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrator"

# Shop details, substituted into the {branch} and {contact} message placeholders.
APX_BRANCH_NAME="APX Motors — Tandang Sora"
APX_CONTACT_NUMBER=

# Which gateway carries a text: log, unisms or semaphore.
#
# log        writes the message to sms_logs and the application log and
#            contacts nobody. Everything else still runs — GSM-7 folding,
#            number normalisation, segment counting, the reminder ledger —
#            so "did the right reminder fire, exactly once?" is answerable
#            without spending a credit per attempt. It cannot tell you
#            whether a carrier delivers anything. This is the default.
# unisms     sends for real. Its default sender ID needs no registration,
#            which is why it can send while a branded name is in review,
#            but expect narrower carrier reach — see App\Services\Sms.
# semaphore  sends for real, domestically routed, branded. Needs a sender
#            name approved on the account first; see below.
SMS_DRIVER=log

# UniSMS. Only read when SMS_DRIVER=unisms. The key goes out as HTTP basic
# auth rather than a form field, and a sender ID is required on every
# message — unset, the app switches SMS off and says which variable is
# missing rather than sending something the gateway will reject.
UNISMS_KEY=
UNISMS_SENDER_ID=
UNISMS_BASE_URL=https://unismsapi.com/api
UNISMS_TIMEOUT=15

# Semaphore. Only read when SMS_DRIVER=semaphore. Leave SEMAPHORE_KEY blank to switch
# SMS off entirely — the app skips the channel and says so rather than failing.
#
# SEMAPHORE_KEY          the API key; sent as an ordinary form field named
#                        apikey, not as a header or bearer token
# SEMAPHORE_SENDER_NAME  optional, and normally left blank: Semaphore then uses
#                        the sender name REGISTERED TO THE ACCOUNT. That name
#                        has to exist and be approved. An account with none
#                        cannot send at all — every call fails with HTTP 500
#                        "No active sender name found", whatever its balance.
#                        Apply for one in the Semaphore dashboard under Sender
#                        Names; the first is free and cannot be changed later.
SEMAPHORE_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_BASE_URL=https://api.semaphore.co/api/v4
SEMAPHORE_TIMEOUT=15

# Scheduler trigger. Render's free tier has no cron jobs, no worker process and
# no shell, so nothing in routes/console.php ticks on its own — reminders
# included. An external cron service (cron-job.org, UptimeRobot, GitHub Actions)
# calls /cron/schedule on an interval and Laravel decides what is due.
#
# Generate a value with `php artisan apx:cron-token`. Left blank, the endpoint
# returns 404 instead of running, so a deploy that forgets this variable cannot
# leave an open way to make the app send mail.
APX_CRON_TOKEN=
