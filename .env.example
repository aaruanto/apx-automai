APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. MAIL_MAILER=log writes messages to storage/logs instead of sending
# them, which is the right default for a fresh checkout. Set it to smtp to
# deliver for real.
#
# Note this app reads MAIL_SCHEME, not MAIL_ENCRYPTION (Laravel 11+). On port
# 587 leave MAIL_SCHEME=null and STARTTLS is negotiated automatically; set it
# to smtps only if you switch to port 465.
#
# For Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME is the
# full Gmail address, and MAIL_PASSWORD is a 16-character Google App Password
# (2-Step Verification must be on) — never the account password.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin bootstrap. Read by `php artisan apx:ensure-admin`, which the Docker
# entrypoint runs on every boot so a fresh deploy has an account to sign in
# with. Leave blank to skip provisioning entirely, and remove ADMIN_PASSWORD
# from the environment once a real admin account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrator"
